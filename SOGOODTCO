local function getTool(toolName)
    if not character then return nil end
    local tool = character:FindFirstChild(toolName)
    if not tool and LocalPlayer:FindFirstChild("Backpack") then
        tool = LocalPlayer.Backpack:FindFirstChild(toolName)
        if tool then tool.Parent = character end
    end
    return tool
end

local function getNearbyParts(maxRange)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local candidateParts = {}
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    local searchList = bricksFolder and bricksFolder:GetDescendants() or Workspace:GetChildren()

    for _, part in ipairs(searchList) do
        if part:IsA("BasePart") and not part:IsDescendantOf(character) then
            if (part.Position - hrp.Position).Magnitude <= maxRange then
                table.insert(candidateParts, part)
            end
        end
    end

    table.sort(candidateParts, function(a, b)
        return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
    end)
    return candidateParts
end

