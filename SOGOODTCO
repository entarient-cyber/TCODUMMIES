-- ------------------------------------------------------------
-- ERROR  LOGGER  (ignores Roblox internal noise)
-- ------------------------------------------------------------
task.spawn(function()
    if DiscordWebhook == "" then return end
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request or httprequest
    if not httpRequest then return end

    local function sendErrorLog(title, msg, color)
        pcall(function()
            httpRequest({
                Url = DiscordWebhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    embeds = {{
                        title = title,
                        description = "```" .. tostring(msg):sub(1, 1800) .. "```",
                        color = color or 0xE74C3C,
                        fields = {
                            {name = "Player", value = LocalPlayer.Name, inline = true},
                            {name = "PlaceId", value = tostring(game.PlaceId), inline = true},
                            {name = "JobId", value = "`" .. game.JobId .. "`", inline = true}
                        },
                        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                    }}
                })
            })
        end)
    end

    LogService.MessageOut:Connect(function(message, messageType)
        if messageType == Enum.MessageType.MessageError then
            local lowerMsg = string.lower(message)
            if string.find(lowerMsg, "coregui")
                or string.find(lowerMsg, "roblox")
                or string.find(lowerMsg, "en-us")
                or string.find(lowerMsg, "locales")
                or string.find(lowerMsg, "modules.common") then
                return
            end
            sendErrorLog("🛑 Script Error / Output", message, 0xE74C3C)
        end
    end)
end)

