TextChatService.OnIncomingMessage = function(mdata)
    if not Config.SpyChat then return end
    local plr = mdata.TextSource and mdata.TextSource.UserId and Players:GetPlayerByUserId(mdata.TextSource.UserId)
    if not plr then return end

    local role = "peasant"
    local hidden = false
    if plr.Neutral == true then
        if plr:GetAttribute("Arken") == true then role = "arken" else role = "peasant" end
    else
        role = "admin"
    end

    if plr:HasTag("Muted") then role = "hidden" end
    if string.sub(mdata.Text, 1, 1) == ";" or string.sub(mdata.Text, 1, 2) == ";!" then
        role = "hidden"
        hidden = true
    end

    local iqTag = nil
    if plr:GetAttribute("IQ") then
        if plr:GetAttribute("IQ") >= 200 then iqTag = "genius 🧠" role = "iqgenius"
        elseif plr:GetAttribute("IQ") <= 50 then iqTag = "dumb 🤪" role = "iqdumb" end
    end

    local extra = ""
    if hidden then extra = extra .. " (HIDDEN CHAT)" end
    if iqTag then extra = extra .. " (" .. iqTag .. ")" end
    if plr:HasTag("Muted") then extra = extra .. " (MUTED)" end

    if cubesFolder then
        mdata.PrefixText = string.format(
            '<font color="%s"><b><font color=\'rgb(%d,%d,%d)\'>[%s%s]: </font></b></font>',
            rankHex[role], rankColors[role][1], rankColors[role][2], rankColors[role][3], plr.DisplayName, extra
        )
    else
        mdata.PrefixText = string.format(
            '<font color="%s"><i><font color=\'rgb(%d,%d,%d)\'>(%s%s) </font></i></font>',
            rankHex[role], rankColors[role][1], rankColors[role][2], rankColors[role][3], plr.DisplayName, extra
        )
    end
end

